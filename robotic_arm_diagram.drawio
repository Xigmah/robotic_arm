        <mxCell id="aBHEOiO-j49hsOtPga2o-3" parent="1" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;Composition View: Ownership&lt;/font&gt;&lt;/span&gt;&lt;/h1&gt;&lt;div style=&quot;padding-left: 0px;&quot;&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;div style=&quot;&quot;&gt;ArmController&lt;/div&gt;&lt;div style=&quot;&quot;&gt;├── KinematicChain&lt;/div&gt;&lt;div style=&quot;&quot;&gt;│&amp;nbsp; &amp;nbsp;├── ArmConfiguration (link lengths, limits, DH params)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;│&amp;nbsp; &amp;nbsp;├── Joint #1 (unique_ptr&amp;lt;Joint&amp;gt;)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;│&amp;nbsp; &amp;nbsp;├── Joint #2 (unique_ptr&amp;lt;Joint&amp;gt;)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;│&amp;nbsp; &amp;nbsp;└── Joint #3 (unique_ptr&amp;lt;Joint&amp;gt;)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;│&lt;/div&gt;&lt;div style=&quot;&quot;&gt;└── InverseKinematics (unique_ptr&amp;lt;IKSolver&amp;gt;)&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp; &amp;nbsp; └── (specific solver implementation)&lt;/div&gt;&lt;/span&gt;&lt;/div&gt;" vertex="1">
