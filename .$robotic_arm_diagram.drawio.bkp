          <mxGeometry height="60" width="310" x="440" y="490" as="geometry" />
        </mxCell>
        <mxCell id="Ex_EJ7yqVigVmRRxfiLb-5" parent="1" style="rounded=0;whiteSpace=wrap;html=1;align=left;" value="&lt;b&gt;ArmCommand&lt;/b&gt;&lt;div&gt;-&amp;gt; Knows: what motion is requested&lt;/div&gt;&lt;div&gt;-&amp;gt; Does: encapsulates command data, validates itself&lt;/div&gt;" vertex="1">
